# Copia este archivo a .env.local y completa los valores. NO subas .env.local a git.

# Obligatorio: URL pública del sitio (desarrollo: http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Opcional hasta el flujo de pedido por WhatsApp.
WHATSAPP_NUMBER=

# Opcional en desarrollo: sin este token, la colección Medios guarda en disco local.
# Obligatorio en producción (Vercel lo define solo al agregar Blob al proyecto).
BLOB_READ_WRITE_TOKEN=

# Obligatorio desde la tarea 4 (Payload + PostgreSQL en Neon).
# Si la URL trae sslmode=require, el proyecto la normaliza a verify-full al conectar.
# También puedes fijarlo en .env.local: ...?sslmode=verify-full
DATABASE_URL=

# Obligatorio con el panel Payload activo. Solo servidor; nunca NEXT_PUBLIC_.
PAYLOAD_SECRET=

# Solo para npm run seed:admin (desarrollo). No usar en producción.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Opcional: npm run seed:textos-sitio — con 1 sobrescribe textos institucionales ya cargados.
SEED_TEXTOS_FORCE=

# Copia este archivo a .env.local y completa los valores. NO subas .env.local a git.

# Obligatorio: URL pública del sitio (desarrollo: http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Opcional hasta el flujo de pedido por WhatsApp.
WHATSAPP_NUMBER=

# Obligatorio desde la tarea 4 (Payload + PostgreSQL en Neon).
DATABASE_URL=

# Obligatorio con el panel Payload activo. Solo servidor; nunca NEXT_PUBLIC_.
PAYLOAD_SECRET=

# Solo para npm run seed:admin (desarrollo). No usar en producción.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

{
  "name": "grovelab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "payload": "node ./node_modules/payload/bin.js --disable-transpile",
    "generate:importmap": "node --env-file=.env.local ./node_modules/payload/bin.js --disable-transpile generate:importmap",
    "generate:types": "node --env-file=.env.local ./node_modules/payload/bin.js --disable-transpile generate:types",
    "migrate:create": "node --env-file=.env.local ./node_modules/payload/bin.js --disable-transpile migrate:create",
    "migrate": "node --env-file=.env.local ./node_modules/payload/bin.js --disable-transpile migrate",
    "migrate:status": "node --env-file=.env.local ./node_modules/payload/bin.js --disable-transpile migrate:status",
    "seed:admin": "node --env-file=.env.local ./node_modules/payload/bin.js --disable-transpile run src/seed/seed-admin.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "graphql": "16.8.1",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
